# Control-plane DB — the smart_layer schema inside the connector app's Supabase project
# (jwyiwddltautdngljqja). Holds ONLY workspaces/connections/report_configs — never brand data.
SUPABASE_URL=https://jwyiwddltautdngljqja.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=

# 32-byte key, base64-encoded, for AES-256-GCM encryption of connection secrets (GA refresh
# tokens, VWO/PSI/Metabase API keys). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

PORT=3000

# Google OAuth (per-workspace GA4 connections) — our own OAuth client, not a service account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connections/google/oauth/callback

# Smart Layer Shopify connector app (token-vending tunnel) — see ai-data-analytics-smart-db-connector repo
CONNECTOR_URL=
CONNECTOR_API_KEY=
CONNECTOR_WEBHOOK_SECRET=
