# Control-plane DB — the smart_layer schema inside the connector app's Supabase project
# (jwyiwddltautdngljqja). Holds ONLY workspaces/connections/report_configs — never brand data.
SUPABASE_URL=https://jwyiwddltautdngljqja.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=

# 32-byte key, base64-encoded, for AES-256-GCM encryption of connection secrets (GA tokens,
# VWO/PSI/Metabase/Shopify-proxy keys). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Runs alongside gnc-smart-layer's sandbox (which owns 3000/5173) — see docs/ARCHITECTURE.md §2
PORT=3001

# Google OAuth (per-workspace GA4 connections) — NOTE: per the 2026-07-20 decision to make every
# connection type a manual paste-a-key flow (no OAuth consent screens, matching how Shopify
# actually works via the connector's fixed proxy key), GA4 may end up using a pasted
# service-account JSON or API key instead of this OAuth app. Revisit before building Phase 1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/connections/google/oauth/callback

# Smart Layer Shopify connector app — base URL only. It's a fixed-key GraphQL PROXY
# (POST {CONNECTOR_URL}/api/graphql, Bearer <the merchant's own pasted proxy key>), not a token
# vendor — there is no global API key or webhook secret to configure here, each brand's proxy key
# is entered per-workspace via ConnectionsHub. See server/connectors/shopify.js.
CONNECTOR_URL=
